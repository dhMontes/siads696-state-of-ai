   "source": [
    "train_df = common[common[\"introduction_year\"].between(2019, 2024)].copy()\n",
    "val_df = common[common[\"introduction_year\"] == 2025].copy()\n",
    "test_df = common[common[\"introduction_year\"] == 2026].copy()\n",
    "\n",
    "for name, subset in [\n",
    "    (\"Train\", train_df),\n",
    "    (\"Validation\", val_df),\n",
    "    (\"Test\", test_df)\n",
    "]:\n",
    "    print(f\"\\n{name}: {len(subset)} bills\")\n",
    "\n",
