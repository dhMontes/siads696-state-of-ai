   "source": [
    "## Introduction Year formatting\n",
    "common[\"Introduction_Date\"] = pd.to_datetime(\n",
    "    common[\"Introduction_Date\"], errors=\"coerce\"\n",
    ")\n",
    "\n",
    "common['introduction_year'] = common['Introduction_Date'].dt.year"
