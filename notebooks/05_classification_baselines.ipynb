   "metadata": {},
   "outputs": [],
   "source": [
    "## Stop words\n",
    "#List created from topic analysis\n",
    "legal_stop_words = sorted(LEGAL_STOPWORDS.keys())\n",
    "#List of English stop words from sklearn and legal stop words from topic analysis\n",
    "english_legal_stop_words = sorted(set(ENGLISH_STOP_WORDS) | LEGAL_STOPWORDS.keys())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "cbcb3b50",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Sets of categorical and numeric features for all models\n",
    "categorical_features = [\n",
    "    \"measure_code\",\n",
    "    \"Jurisdiction\",\n",
    "    \"State_Political_Control\"\n",
    "]\n",
    "\n",
    "numeric_features = [\n",
    "    \"D_Count\",\n",
    "    \"R_Count\",\n",
    "    \"Other_Count\",\n",
    "    \"Unknown_Count\",\n",
    "    \"Total_Sponsors\"\n",
    "]\n",
    "\n",
    "ratio_features = [\n",
    "    \"Democrat_Sponsor_Ratio\",\n",
    "    \"Republican_Sponsor_Ratio\"\n",
    "]\n",
    "\n",
    "binary_features = [\n",
    "    \"Bipartisan_Support\"\n",
    "]\n",
    "\n",
    "TARGET = \"Bill_Status_Grouped\"\n",
    "RANDOM_STATE = 42\n",
    "\n",
    "FEATURE_GROUPS = {\n",
    "    \"categorical\": categorical_features,\n",
    "    \"numeric\": numeric_features,\n",
    "    \"ratio\": ratio_features,\n",
    "    \"binary\": binary_features,\n",
    "}\n",
    "\n",
    "FEATURE_SETS = {\n",
    "    \"metadata\": None,\n",
    "    \"summary\": \"NCSL_Summary_clean\",\n",
    "    \"bill_text\": \"Bill_Text_clean\",\n",
    "}\n",
    "\n",
    "TFIDF_PARAMS = {\n",
    "    \"max_features\": 5000,\n",
    "    \"ngram_range\": (1, 2),\n",
    "    \"min_df\": 2,\n",
    "    \"max_df\": 0.95,\n",
    "    \"sublinear_tf\": True,\n",
    "    \"stop_words\": legal_stop_words,\n",
    "}\n"
   ]
  },
